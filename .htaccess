RewriteEngine On

# 1. Redirect direct visits to the .html file to the clean URL (to prevent duplicate content in Google)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Internally load the .html file when the clean URL is requested
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
